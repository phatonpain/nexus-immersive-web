 @import './dark-premium.css';
 
+/* Contain interactive 3D inside its own stage, below actionable content. */
+.hero,
+.services-section { isolation: isolate; }
+.hero-copy,
+.hero-actions,
+.scroll-cue,
+.services-grid { position: relative; z-index: 3; pointer-events: auto; }
+.scroll-cue { position: absolute; }
+.hero-visual { z-index: 1; }
+.hero-visual > .tech-strip { z-index: 2; }
+.visual-orbit,
+.hero-visual::before,
+.hero::before,
+.services-section::before { pointer-events: none; }
+.services-section .heading-aside > p,
+.services-section .heading-aside > .inline-link { position: relative; z-index: 3; }
+.spline-stage {
+  position: relative;
+  isolation: isolate;
+  width: 100%;
+  min-width: 0;
+  overflow: hidden;
+  border: 1px solid var(--line-strong);
+  border-radius: 32px;
+  background: radial-gradient(ellipse at center, rgba(139,92,246,.1), transparent 72%), var(--paper);
+}
+.spline-stage--hero { max-width: 560px; aspect-ratio: 1 / 1; }
+.spline-stage--services { margin-top: 24px; aspect-ratio: 4 / 3; }
+.spline-fallback { position: absolute; z-index: 0; inset: 0; pointer-events: none; }
+.spline-fallback > .artwork-slot { width: 100%; height: 100%; margin: 0; border: 0; border-radius: inherit; }
+.spline-stage:has(> .spline-wrapper.is-loaded) > .spline-fallback { visibility: hidden; }
+.spline-stage > .spline-wrapper { transition: opacity .4s ease; }
+.spline-stage .spline-wrapper > div { width: 100%; height: 100%; }
+.spline-stage--services .spline-canvas-container {
+  flex: 0 0 256%;
+  width: 256% !important;
+  height: 256% !important;
+  transform: scale(.390625);
+}
+.spline-stage .spline-wrapper canvas {
+  display: block;
+  width: 100% !important;
+  height: 100% !important;
+  pointer-events: auto;
+  touch-action: pan-y;
+}
+@media (max-width: 767px) {
+  .spline-stage > .spline-wrapper { display: none !important; }
+  .spline-stage { border-radius: 24px; }
+  .spline-stage--hero { max-width: 440px; aspect-ratio: 4 / 5; }
+  .spline-stage--services { aspect-ratio: 16 / 9; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .spline-stage > .spline-wrapper { display: none !important; transition: none; }
+}
